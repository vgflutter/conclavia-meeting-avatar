PORT=4310
HOST=127.0.0.1
CONCLAVIA_WAKE_WORD=Mary
CONCLAVIA_DIALOGUE_TIMEOUT_MS=45000
CONCLAVIA_DIALOGUE_MAX_FOLLOW_UPS=2
CONCLAVIA_CONFIG_PATH=.conclavia/avatar-config.json
# The renderer API is served by this companion; override only for a remote API.
CONCLAVIA_RENDERER_URL=http://127.0.0.1:4310
# Use web to run without a cloud GPU. The default remains unreal; install each
# private Web LOD separately under CONCLAVIA_WEB_AVATAR_DIRECTORY.
CONCLAVIA_RENDERER_MODE=unreal
# Local directory containing <avatar-id>/manifest.json and one embedded-texture GLB.
CONCLAVIA_WEB_AVATAR_DIRECTORY=.conclavia/web-avatars
CONCLAVIA_LOCAL_STUDIO_LIFECYCLE=true
CONCLAVIA_MEETING_AUDIO_DEVICE=BlackHole 16ch
CONCLAVIA_MEETING_SPEAKER_NAME=Meeting participant
OPENAI_API_KEY=
OPENAI_RESPONSE_MODEL=gpt-5.4-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-transcribe

# Optional durable memory shared by meetings in the same workspace/project.
# CONCLAVIA_MEMORY_MONGODB_URI takes precedence; MONGODB_URI is also accepted
# so an existing Conclavia Mongo deployment can be reused without code coupling.
CONCLAVIA_MEMORY_MONGODB_URI=
CONCLAVIA_MEMORY_MONGODB_DATABASE=conclavia
CONCLAVIA_MEMORY_WORKSPACE_ID=default
CONCLAVIA_MEMORY_PROJECT_ID=general
CONCLAVIA_MEMORY_RETENTION_DAYS=365

# AWS and Unreal runtime. npm run studio:3d:start writes the rotating URLs and
# supervisor token to the ignored .env file without exposing them to Git.
AWS_REGION=eu-central-1
AWS_PROFILE=conclavia-studio
CONCLAVIA_AWS_PROFILE=conclavia-studio
UNREAL_STUDIO_AWS_REGION=eu-central-1
UNREAL_STUDIO_INSTANCE_ID=i-033248199865f3e6e
CONCLAVIA_STUDIO_SECURITY_GROUP_ID=sg-0b2e4054a32145ed7
CONCLAVIA_STUDIO_AUTOMATION_BUCKET=conclavia-unreal-poc-transfer-194000006241
UNREAL_STUDIO_PROFILE=lipsync58

# Optional official Microsoft Teams agent. The Teams developer CLI supplies
# CLIENT_ID, TENANT_ID and local development credentials after registration.
CONCLAVIA_TEAMS_AGENT_PORT=3978
CONCLAVIA_COMPANION_URL=http://127.0.0.1:4310
