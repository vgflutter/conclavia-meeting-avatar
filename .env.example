MONGODB_URI=mongodb://USER:PASSWORD@127.0.0.1:27017/conclave?authSource=AUTH_DB

# Optional meeting intelligence. Without it, commands use stored memory locally.
MEETING_AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MEETING_MODEL=gpt-5.4-mini

# Streaming voice for hosted meetings. Keep credentials server-side (never NEXT_PUBLIC_).
# Streaming is required for speech; missing credentials disable voice output.
MEETING_TTS_PROVIDER=inworld
INWORLD_API_KEY=
# Copy Base64 credentials from Inworld Settings > API Keys; do not encode them again.
INWORLD_TTS_MODEL=inworld-tts-2-flash
# Dennis is the documented built-in starting voice; audition an Italian voice before release.
INWORLD_VOICE_ID=Dennis
# Native Italian voice; separate from the English/default voice above.
INWORLD_VOICE_ID_IT=Gianni
# No browser synthesis fallback is available.

# Keep preview for local UI work; use attendee for autonomous Microsoft Teams entry.
MEETING_BOT_PROVIDER=preview
CONCLAVIA_PUBLIC_URL=https://conclavia.example.com
TEAMS_ACCESS_MODE=anonymous_guest
TEAMS_GUEST_ACCOUNT_EMAIL=collega@conclavia.example.com
TEAMS_GUEST_DISPLAY_NAME=Conclavia
TEAMS_SIGNED_IN_CONFIRMED=false

ATTENDEE_API_BASE_URL=https://app.attendee.dev/api/v1
ATTENDEE_API_KEY=
# Recommended in production. The per-meeting callback token is used during local trials.
ATTENDEE_WEBHOOK_SECRET=

# Legacy provider retained only for existing deployments.
RECALL_API_BASE_URL=https://eu-central-1.recall.ai/api/v1
RECALL_API_KEY=
RECALL_WEBHOOK_SECRET=
