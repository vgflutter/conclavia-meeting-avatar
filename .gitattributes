# Keep the complete Daily creative archive without putting binary video in Git packs.
public/daily-launch/** filter=lfs diff=lfs merge=lfs -text
docs/images/** filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text

# Preserve upstream font-license bytes and their original whitespace.
public/brand/*-OFL.txt -text whitespace=-blank-at-eol,-blank-at-eof
public/daily-studio/*-OFL.txt -text whitespace=-blank-at-eol,-blank-at-eof
