{
  "name": "conclavia-meeting-avatar",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22.21.1"
  },
  "scripts": {
    "dev": "next dev",
    "dev:system-ca": "node scripts/dev-with-system-ca.mjs",
    "tunnel": "node scripts/local-tunnel.mjs",
    "tunnel:check": "node scripts/local-tunnel.mjs --check",
    "test:tunnel": "node --test tests/scripts/local-tunnel.test.mjs",
    "test:scripts": "node --test tests/scripts/*.test.mjs",
    "test:podcast": "node --test tests/scripts/podcast*.test.mjs",
    "diagnose:captions": "node scripts/diagnose-captions.mjs",
    "diagnose:entry": "node scripts/diagnose-entry.mjs",
    "test:diagnostics": "node --test tests/scripts/diagnostics.test.mjs",
    "test:captions": "node --test tests/scripts/diagnose-captions.test.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "docs:screenshots": "playwright test --config playwright.docs.config.ts",
    "test:live": "node scripts/verify-live.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test:scripts && npm run build && npm run test:e2e",
    "check:avatar-kit": "npm --prefix ../conclavia-avatar-kit run check:consumers",
    "tg:worker": "node --conditions=react-server --import tsx --env-file-if-exists=.env.local scripts/tg/worker.ts",
    "test:tg": "node --conditions=react-server --import tsx --test tests/tg/*.test.ts",
    "tg:preview:hands": "node scripts/tg/build-hand-motion-preview.mjs",
    "tg:render:hands": "node scripts/tg/build-hand-motion-preview.mjs && node scripts/tg/render-hand-motion-preview.mjs",
    "daily:agent": "node --conditions=react-server --import tsx --env-file-if-exists=.env.local scripts/tg/daily-agent.ts",
    "daily:mac": "node --conditions=react-server --import tsx --env-file-if-exists=.env.local scripts/tg/mac-agent.mjs",
    "daily:voice": "node --conditions=react-server --import tsx --env-file-if-exists=.env.local scripts/tg/alex2-voice.ts"
  },
  "dependencies": {
    "@conclavia/avatar-kit": "file:../conclavia-avatar-kit",
    "fast-xml-parser": "5.11.2",
    "mongoose": "8.24.2",
    "next": "16.3.8",
    "onnxruntime-web": "^1.23.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "three": "^0.185.1",
    "tsx": "4.20.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.185.4",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "esbuild": "0.25.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vgflutter/conclavia-meeting-avatar.git"
  }
}
