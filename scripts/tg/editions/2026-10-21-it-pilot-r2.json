  "lines": [
    {
      "scene": "apertura",
      "text": "Fondi annunciati ai trasportatori, ma una parte dei blocchi continua.",
      "mood": "attention",
      "intensity": 0.8,
      "intent": "explain",
      "sourceIds": [],
      "screenText": "Trasporti: fondi e proteste."
    },
    {
      "scene": "apertura",
      "text": "Nuovi colloqui sull’Ucraina.",
      "mood": "attention",
      "intensity": 0.8,
      "intent": "explain",
      "sourceIds": [],
      "screenText": "Ucraina: nuovi colloqui."
    },
    {
      "scene": "apertura",
      "text": "E una mappa che racconta dove stiamo cambiando le riserve d’acqua.",
      "mood": "attention",
      "intensity": 0.8,
      "intent": "explain",
      "sourceIds": [],
      "screenText": "L’acqua, vista dallo spazio."
    },
    {
      "scene": "apertura",
      "text": "È il ventuno ottobre: quattro minuti, con gli aggiornamenti verificati di ieri sera.",
      "mood": "attention",
      "intensity": 0.8,
      "intent": "explain",
      "sourceIds": [],
      "screenText": "Quattro minuti. Il punto sulle notizie."
    },
    {
      "scene": "apertura",
      "text": "Partiamo.",
      "mood": "attention",
      "intensity": 0.8,
      "intent": "explain",
      "sourceIds": [],
      "screenText": "Quattro minuti. Il punto sulle notizie."
    },
    {
      "scene": "trasporti",
      "text": "La prima notizia arriva dai trasporti.",
      "mood": "attention",
      "intensity": 0.77,
      "intent": "explain",
      "sourceIds": [
        "ansa-trasporti"
      ],
      "screenText": "Trasporti: fondi e proteste."
    },
    {
      "scene": "trasporti",
      "text": "Dopo il vertice di Milano, il governo annuncia risorse per il settore, colpito dal caro gasolio.",
      "mood": "attention",
      "intensity": 0.77,
      "intent": "explain",
      "sourceIds": [
        "ansa-trasporti"
      ],
      "screenText": "Fondi contro il caro gasolio."
    },
    {
      "scene": "trasporti",
      "text": "Il ministro Salvini parla di quattrocentottanta milioni immediati e di un impegno complessivo superiore al miliardo.",
      "mood": "attention",
      "intensity": 0.77,
      "intent": "explain",
      "sourceIds": [
        "ansa-trasporti"
      ],
      "screenText": "480 milioni: l’annuncio del governo."
    },
    {
      "scene": "trasporti",
      "text": "Sono le cifre annunciate dal governo: non la prova di accrediti già arrivati a tutte le imprese.",
      "mood": "attention",
      "intensity": 0.77,
      "intent": "explain",
      "sourceIds": [
        "ansa-trasporti"
      ],
      "screenText": "Pagamenti: attesa la verifica."
    },
    {
      "scene": "trasporti",
      "text": "E infatti la protesta non si chiude ovunque.",
      "mood": "attention",
      "intensity": 0.74,
      "intent": "contrast",
      "sourceIds": [
        "ansa-trasporti"
      ],
      "screenText": "Proteste ancora aperte."
    },
    {
      "scene": "trasporti",
      "text": "La Sicilia revoca il fermo; in Calabria e Campania i presidi proseguono.",
      "mood": "attention",
      "intensity": 0.74,
      "intent": "contrast",
      "sourceIds": [
        "ansa-trasporti"
      ],
      "screenText": "Sicilia: revocato il fermo."
    },
    {
      "scene": "trasporti",
      "text": "In Puglia gli autonomi annunciano una revoca soltanto parziale dei blocchi, in attesa di risposte concrete.",
      "mood": "attention",
      "intensity": 0.74,
      "intent": "contrast",
      "sourceIds": [
        "ansa-trasporti"
      ],
      "screenText": "Puglia: revoca parziale."
    },
    {
      "scene": "trasporti",
      "text": "Situazioni diverse, dunque, anche tra territori vicini.",
      "mood": "attention",
      "intensity": 0.74,
      "intent": "contrast",
      "sourceIds": [
        "ansa-trasporti"
      ],
      "screenText": "Decisioni diverse per regione."
    },
    {
      "scene": "trasporti",
      "text": "Il prossimo passaggio indicato dal ministro è un altro tavolo, il ventisette ottobre, per verificare l’avvio dei pagamenti.",
      "mood": "attention",
      "intensity": 0.73,
      "intent": "emphasize",
      "sourceIds": [
        "ansa-trasporti",
        "pmi-trasporti"
      ],
      "screenText": "Nuovo tavolo il 27 ottobre."
    },
    {
      "scene": "trasporti",
      "text": "Claudio Riva, di Confartigianato Trasporti, riferisce intanto un calendario atteso per lo sblocco dei crediti.",
      "mood": "attention",
      "intensity": 0.73,
      "intent": "emphasize",
      "sourceIds": [
        "ansa-trasporti",
        "pmi-trasporti"
      ],
      "screenText": "Crediti: un calendario annunciato."
    },
    {
      "scene": "trasporti",
      "text": "I tempi riportati nei resoconti non coincidono tutti: per ora teniamo distinti gli impegni, gli accrediti effettivi e le decisioni sui blocchi.",
      "mood": "attention",
      "intensity": 0.73,
      "intent": "emphasize",
      "sourceIds": [
        "ansa-trasporti",
        "pmi-trasporti"
      ],
      "screenText": "Impegni e accrediti: cosa verificare."
    },
    {
      "scene": "mondo",
      "text": "Seconda storia, l’Ucraina.",
      "mood": "attention",
      "intensity": 0.76,
      "intent": "explain",
      "sourceIds": [
        "norvegia"
      ],
      "screenText": "Ucraina: nuovi colloqui a Oslo."
    },
    {
      "scene": "mondo",
      "text": "A Oslo si incontrano il presidente Zelensky, l’inviato americano Steve Witkoff e i leader di Norvegia e Finlandia.",
      "mood": "attention",
      "intensity": 0.76,
      "intent": "explain",
      "sourceIds": [
        "norvegia"
      ],
      "screenText": "Il tavolo di Oslo."
    },
    {
      "scene": "mondo",
      "text": "Jared Kushner partecipa da remoto.",
      "mood": "attention",
      "intensity": 0.76,
      "intent": "explain",
      "sourceIds": [
        "norvegia"
      ],
      "screenText": "Il tavolo di Oslo."
    },
    {
      "scene": "mondo",
      "text": "È la composizione del tavolo confermata dal governo norvegese, che ospita i colloqui.",
      "mood": "attention",
      "intensity": 0.76,
      "intent": "explain",
      "sourceIds": [
        "norvegia"
      ],
      "screenText": "Il tavolo di Oslo."
    },
    {
      "scene": "mondo",
      "text": "Il premier Jonas Støre descrive l’incontro come costruttivo e dice che le squadre americane ed europee hanno lavorato con l’Ucraina sui nodi della trattativa.",
      "mood": "attention",
      "intensity": 0.7,
      "intent": "contrast",
      "sourceIds": [
        "norvegia"
      ],
      "screenText": "Støre: «Colloqui costruttivi»."
    },
    {
      "scene": "mondo",
      "text": "È la valutazione del premier: nella dichiarazione resta esplicita la necessità di altro lavoro diplomatico.",
      "mood": "attention",
      "intensity": 0.7,
      "intent": "contrast",
      "sourceIds": [
        "norvegia"
      ],
      "screenText": "Il negoziato resta aperto."
    },
    {
      "scene": "mondo",
      "text": "Non viene presentato un accordo di pace concluso.",
      "mood": "attention",
      "intensity": 0.7,
      "intent": "contrast",
      "sourceIds": [
        "norvegia"
      ],
      "screenText": "Il negoziato resta aperto."
    },
    {
      "scene": "mondo",
      "text": "Tra i temi citati ci sono sicurezza, territori, sanzioni e ricostruzione economica dopo la guerra.",
      "mood": "attention",
      "intensity": 0.7,
      "intent": "contrast",
      "sourceIds": [
        "norvegia"
      ],
      "screenText": "Sicurezza, territori e sanzioni."
    },
    {
      "scene": "mondo",
      "text": "Il premier annuncia anche un successivo incontro di Witkoff con la leadership russa: un passaggio previsto, di cui andrà verificato l’esito.",
      "mood": "attention",
      "intensity": 0.7,
      "intent": "contrast",
      "sourceIds": [
        "norvegia"
      ],
      "screenText": "Annunciato un nuovo incontro."
    },
    {
      "scene": "mondo",
      "text": "Støre ribadisce anche la posizione norvegese: le decisioni che riguardano l’Ucraina devono coinvolgere l’Ucraina.",
      "mood": "attention",
      "intensity": 0.73,
      "intent": "reflect",
      "sourceIds": [
        "norvegia"
      ],
      "screenText": "La posizione norvegese."
    },
    {
      "scene": "mondo",
      "text": "Per seguire la notizia conta distinguere ciò che i partecipanti dichiarano dalle condizioni effettivamente concordate.",
      "mood": "attention",
      "intensity": 0.73,
      "intent": "reflect",
      "sourceIds": [
        "norvegia"
      ],
      "screenText": "Il negoziato resta aperto."
    },
    {
      "scene": "mondo",
      "text": "Il fatto verificato, qui, è che il confronto è avvenuto; l’esito del negoziato resta aperto.",
      "mood": "attention",
      "intensity": 0.73,
      "intent": "reflect",
      "sourceIds": [
        "norvegia"
      ],
      "screenText": "Il negoziato resta aperto."
    },
    {
      "scene": "mondo",
      "text": "Niente anticipazioni su clausole o scadenze che questa dichiarazione non conferma.",
      "mood": "attention",
      "intensity": 0.73,
      "intent": "reflect",
      "sourceIds": [
        "norvegia"
      ],
      "screenText": "Il negoziato resta aperto."
    },
    {
      "scene": "scienza",
      "text": "Adesso una domanda diversa: come si misura l’acqua nascosta sotto terra, guardandola dallo spazio?",
      "mood": "curiosity",
      "intensity": 0.79,
      "intent": "question",
      "sourceIds": [
        "nasa"
      ],
      "screenText": "Come si misura l’acqua dallo spazio?"
    },
    {
      "scene": "scienza",
      "text": "Una ricerca presentata dalla NASA mette insieme oltre vent’anni di osservazioni delle missioni Grace e Grace Follow-On.",
      "mood": "curiosity",
      "intensity": 0.79,
      "intent": "question",
      "sourceIds": [
        "nasa"
      ],
      "screenText": "Oltre vent’anni di osservazioni."
    },
    {
      "scene": "scienza",
      "text": "I satelliti registrano piccole variazioni della gravità, che aiutano a ricostruire dove le riserve d’acqua aumentano o diminuiscono.",
      "mood": "curiosity",
      "intensity": 0.79,
      "intent": "question",
      "sourceIds": [
        "nasa"
      ],
      "screenText": "La gravità rivela le riserve d’acqua."
    },
    {
      "scene": "scienza",
      "text": "L’analisi copre il periodo dall’aprile duemiladue al novembre duemilaventicinque e riguarda l’acqua immagazzinata sulle terre emerse.",
      "mood": "attention",
      "intensity": 0.75,
      "intent": "explain",
      "sourceIds": [
        "nasa"
      ],
      "screenText": "Dati dal 2002 al 2025."
    },
    {
      "scene": "scienza",
      "text": "In quaranta regioni le variazioni mostrano associazioni con attività umane: irrigazione, riempimento dei bacini e cambiamenti nell’uso del suolo.",
      "mood": "attention",
      "intensity": 0.75,
      "intent": "explain",
      "sourceIds": [
        "nasa"
      ],
      "screenText": "40 regioni, anche la traccia umana."
    },
    {
      "scene": "scienza",
      "text": "Il clima rimane parte del quadro, insieme a come usiamo e spostiamo l’acqua.",
      "mood": "attention",
      "intensity": 0.75,
      "intent": "explain",
      "sourceIds": [
        "nasa"
      ],
      "screenText": "Clima e uso dell’acqua."
    },
    {
      "scene": "scienza",
      "text": "La novità è il dettaglio: la mappa distingue aree più piccole rispetto alle analisi precedenti.",
      "mood": "curiosity",
      "intensity": 0.74,
      "intent": "contrast",
      "sourceIds": [
        "nasa"
      ],
      "screenText": "Una mappa più dettagliata."
    },
    {
      "scene": "scienza",
      "text": "Ma c’è un compromesso: guadagna precisione nello spazio e perde dettaglio nel tempo.",
      "mood": "attention",
      "intensity": 0.74,
      "intent": "contrast",
      "sourceIds": [
        "nasa"
      ],
      "screenText": "Più dettaglio nello spazio."
    },
    {
      "scene": "scienza",
      "text": "Serve a leggere tendenze di lungo periodo; non prevede quando arriverà la prossima siccità.",
      "mood": "curiosity",
      "intensity": 0.74,
      "intent": "contrast",
      "sourceIds": [
        "nasa"
      ],
      "screenText": "Tendenze, non previsioni di siccità."
    },
    {
      "scene": "scienza",
      "text": "È uno strumento per capire meglio un cambiamento già osservato.",
      "mood": "curiosity",
      "intensity": 0.74,
      "intent": "contrast",
      "sourceIds": [
        "nasa"
      ],
      "screenText": "Un cambiamento già osservato."
    },
    {
      "scene": "scienza",
      "text": "Tra le aree descritte ci sono la California e l’India settentrionale, dove pesa il ricorso all’acqua sotterranea.",
      "mood": "curiosity",
      "intensity": 0.74,
      "intent": "contrast",
      "sourceIds": [
        "nasa"
      ],
      "screenText": "California e India settentrionale."
    },
    {
      "scene": "meteo",
      "text": "Ultimo aggiornamento, la Liguria.",
      "mood": "attention",
      "intensity": 0.75,
      "intent": "explain",
      "sourceIds": [
        "arpal",
        "ansa-meteo"
      ],
      "screenText": "Liguria: il bollettino di ieri."
    },
    {
      "scene": "meteo",
      "text": "Il bollettino di ieri estendeva l’allerta arancione anche alla notte, con scadenze differenti per zona.",
      "mood": "attention",
      "intensity": 0.75,
      "intent": "explain",
      "sourceIds": [
        "arpal",
        "ansa-meteo"
      ],
      "screenText": "Allerta: scadenze diverse per zona."
    },
    {
      "scene": "meteo",
      "text": "Sul Ponente indicava il passaggio al giallo alle due; nelle altre zone alle sei.",
      "mood": "attention",
      "intensity": 0.75,
      "intent": "explain",
      "sourceIds": [
        "arpal",
        "ansa-meteo"
      ],
      "screenText": "Contano la zona e l’orario."
    },
    {
      "scene": "meteo",
      "text": "Anche la fine del giallo era distribuita tra le sei, le nove e le quattordici.",
      "mood": "attention",
      "intensity": 0.75,
      "intent": "explain",
      "sourceIds": [
        "arpal",
        "ansa-meteo"
      ],
      "screenText": "Contano la zona e l’orario."
    },
    {
      "scene": "meteo",
      "text": "Perché riportare gli orari?",
      "mood": "attention",
      "intensity": 0.72,
      "intent": "emphasize",
      "sourceIds": [
        "arpal"
      ],
      "screenText": "Perché guardare gli orari?"
    },
    {
      "scene": "meteo",
      "text": "Perché un titolo regionale da solo non descrive la situazione del proprio comune.",
      "mood": "attention",
      "intensity": 0.72,
      "intent": "emphasize",
      "sourceIds": [
        "arpal"
      ],
      "screenText": "Conta la situazione locale."
    },
    {
      "scene": "meteo",
      "text": "Arpal segnalava temporali persistenti e chiedeva di seguire gli aggiornamenti.",
      "mood": "attention",
      "intensity": 0.72,
      "intent": "emphasize",
      "sourceIds": [
        "arpal"
      ],
      "screenText": "Temporali: segui gli aggiornamenti."
    },
    {
      "scene": "meteo",
      "text": "Questo è il riepilogo del bollettino di ieri: per decidere oggi contano l’ultimo avviso ufficiale e le indicazioni locali. Il passaggio a un colore diverso non significa che ogni rischio sia sparito.",
      "mood": "attention",
      "intensity": 0.72,
      "intent": "emphasize",
      "sourceIds": [
        "arpal"
      ],
      "screenText": "Consulta l’ultimo bollettino."
    },
    {
      "scene": "chiusura",
      "text": "Per le fonti e gli approfondimenti, vai su daily.conclavia.me.",
      "mood": "agreement",
      "intensity": 0.79,
      "intent": "invite",
      "sourceIds": []
    },
    {
      "scene": "chiusura",
      "text": "Segui Conclavia Daily: ci ritroviamo con le prossime notizie.",
      "mood": "agreement",
      "intensity": 0.79,
      "intent": "invite",
      "sourceIds": []
    },
    {
      "scene": "chiusura",
      "text": "Meno rumore, più contesto.",
      "mood": "agreement",
      "intensity": 0.79,
      "intent": "invite",
      "sourceIds": []
    }
  ],
